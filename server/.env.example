# Copy this file to .env and fill in your key.
# Get a free Gemini API key at https://aistudio.google.com/app/apikey
# Keys now start with "AQ." (Google's newer auth-key format) — that's expected.
GEMINI_API_KEY=your_key_here

# Optional, defaults to 5000
PORT=5000

# Optional, defaults to gemini-3.5-flash-lite (free tier)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional, restricts which frontend origin(s) may call this API in production.
# Leave unset for local dev (allows all origins). Comma-separate for multiple.
# CLIENT_ORIGIN=https://your-frontend.vercel.app